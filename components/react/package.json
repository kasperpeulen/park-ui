{
  "name": "@park-ui/react",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare": "panda codegen --clean --silent",
    "dev": "bun run storybook",
    "lint": "biome lint ./src",
    "storybook": "storybook dev -p 6006",
    "typecheck": "tsc",
    "registry:prepare": "scripts registry prepare --name @park-ui/react",
    "registry:build": "scripts registry build react",
    "typedoc": "scripts typedoc --out ../../website/public/types/react",
    "build-storybook": "storybook build"
  },
  "exports": {
    "./examples": "./src/examples/index.ts",
    ".": "./src/components/ui/index.ts"
  },
  "dependencies": {
    "@ark-ui/react": "5.30.0",
    "lucide-react": "0.561.0"
  },
  "devDependencies": {
    "@pandacss/dev": "1.7.0",
    "@pandacss/preset-base": "1.7.0",
    "@pandacss/preset-panda": "1.7.0",
    "@park-ui/preset": "workspace:*",
    "@park-ui/scripts": "workspace:*",
    "@tanstack/react-virtual": "3.13.13",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "@vitest/browser-playwright": "4.0.17",
    "lorem-ipsum": "2.0.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "7.2.7",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.0.17",
    "storybook": "10.2.0-beta.0",
    "@storybook/react-vite": "10.2.0-beta.0",
    "@chromatic-com/storybook": "^5.0.0",
    "@storybook/addon-vitest": "10.2.0-beta.0",
    "@storybook/addon-a11y": "10.2.0-beta.0",
    "@storybook/addon-docs": "10.2.0-beta.0",
    "playwright": "^1.57.0",
    "@vitest/coverage-v8": "4.0.17"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
